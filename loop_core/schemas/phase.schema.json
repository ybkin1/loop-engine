{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev/schemas/phase.schema.json",
  "title": "Loop Phase Definition",
  "description": "Definition of a single phase in the Loop engineering lifecycle.",
  "type": "object",
  "required": ["phase_id", "name", "inputs", "outputs", "required_roles"],
  "properties": {
    "phase_id": {
      "type": "string",
      "enum": [
        "S0-init", "S1-requirements", "S2-architecture", "S3-interface",
        "S4-implementation", "S5-quality", "S6-delivery",
        "S7-integration", "S8-functional-test", "S9-fix-optimize",
        "S10-performance", "S11-maintenance"
      ]
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "from_phase": { "type": "string" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "format": { "type": "string" },
          "human_reviewable": { "type": "boolean" }
        }
      }
    },
    "required_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optional_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gate_type": { "type": "string" },
    "allows_mini_loop": {
      "type": "boolean",
      "description": "Whether this phase supports internal review→fix→re-review cycles"
    },
    "blocking_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Conditions that prevent entering this phase"
    },
    "exit_criteria": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
