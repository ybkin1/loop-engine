{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev/schemas/task.schema.json",
  "title": "Loop Task",
  "description": "A unit of work in the Loop engineering process.",
  "type": "object",
  "required": ["id", "title", "status", "phase"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-\\d{4}$"
    },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "in_progress", "completed", "blocked", "rejected"]
    },
    "phase": {
      "type": "string",
      "description": "Which Loop phase this task belongs to"
    },
    "developer_agent_id": {
      "type": ["string", "null"],
      "description": "Agent ID of the developer who implemented this task"
    },
    "reviewer_agent_id": {
      "type": ["string", "null"],
      "description": "Agent ID of the reviewer. MUST differ from developer_agent_id."
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "SHA256 hashes of input files, frozen before execution"
    },
    "required_roles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Roles required for this task's phase"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "note": { "type": "string" },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["depends_on", "blocks"] }
        }
      }
    }
  }
}
