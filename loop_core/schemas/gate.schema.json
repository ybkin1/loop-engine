{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev/schemas/gate.schema.json",
  "title": "Loop Gate",
  "description": "A user decision point in the Loop engineering process.",
  "type": "object",
  "required": ["id", "task_id", "gate_type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique gate identifier, e.g. G-T-0022-REQUIREMENTS-DESIGN"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-\\d{4}$"
    },
    "gate_type": {
      "type": "string",
      "enum": [
        "user-design", "user-approval", "user-implementation",
        "user-quality", "user-delivery", "user-repair",
        "user-activation", "user-installation", "user-review-only",
        "user-discovery-approval", "user-cleanup"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "blocked"]
    },
    "decision": {
      "type": "string",
      "enum": ["pending", "approved", "rejected"]
    },
    "approval_actor": {
      "type": "string",
      "enum": ["user", "ai"],
      "description": "MUST be 'user' for any gate that authorizes code changes"
    },
    "approval_source": {
      "type": "string",
      "enum": ["explicit_user_message", "ai_recommendation"],
      "description": "ai_recommendation is evidence only, NOT approval"
    },
    "scope": { "type": "string" },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_roles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Roles that must produce output before this gate can be approved"
    },
    "blocked_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Role IDs whose BLOCKED verdicts prevent this gate from passing"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
