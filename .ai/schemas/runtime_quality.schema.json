{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loop-engine/runtime-quality.schema.json",
  "title": "Runtime Quality Report",
  "description": "Unified runtime delivery gate result schema. All non-PASS statuses cause overall=BLOCKED.",
  "type": "object",
  "required": ["schemaVersion", "execution_mode", "agent_takeover", "overall", "checks", "executed_at"],
  "additionalProperties": false,
  "properties": {
    "execution_mode": {
      "type": "string",
      "const": "SIMULATED_MAIN_SESSION"
    },
    "agent_takeover": {
      "type": "boolean",
      "const": false
    },
    "schemaVersion": {
      "type": "string",
      "const": "runtime-quality.v1"
    },
    "overall": {
      "type": "string",
      "enum": ["PASS", "BLOCKED"],
      "description": "PASS: all checks passed. BLOCKED: at least one check is FAIL/ERROR/SKIPPED/NOT_RUN."
    },
    "blocked_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of check IDs that caused the BLOCKED overall status."
    },
    "repair_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "check_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKER", "WARNING"] },
          "suggested_files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "description": "Unique check identifier" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "ERROR", "SKIPPED", "NOT_RUN"],
            "description": "PASS=allowed. All other values cause overall=BLOCKED."
          },
          "detail": { "type": "string" },
          "evidence": { "type": "string", "description": "Path to evidence file or inline evidence" },
          "duration_ms": { "type": "number" }
        }
      }
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of gate execution."
    },
    "build_id": {
      "type": "string",
      "description": "Build identifier for the artifact being checked."
    },
    "environment": {
      "type": "object",
      "properties": {
        "service_url": { "type": "string" },
        "project_root": { "type": "string" },
        "node_version": { "type": "string" },
        "python_version": { "type": "string" }
      }
    }
  }
}
