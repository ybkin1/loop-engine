{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engine.dev/schemas/plan-draft.schema.json",
  "title": "Plan Draft",
  "description": "An auto-generated plan that decomposes a requirement into tasks. DRAFTS are read-only — must be approved via a plan-approval Gate before tasks are registered.",
  "type": "object",
  "required": ["plan_id", "requirement_id", "tasks", "edges", "estimated_phases", "created_at"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^PLAN-\\d{8}-\\d{3}$" },
    "requirement_id": { "type": "string", "pattern": "^REQ-\\d{8}-\\d{3}$" },
    "status": { "type": "string", "enum": ["DRAFT", "REVIEW", "APPROVED", "REJECTED", "SUPERSEDED"], "default": "DRAFT" },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "description", "phase"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1 },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "phase": { "type": "string" },
          "suggested_roles": { "type": "array", "items": { "type": "string" } },
          "estimated_complexity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "default": "MEDIUM" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"], "default": "P2" },
          "depends_on_plan_index": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_task_index", "to_task_index", "edge_type"],
        "properties": {
          "from_task_index": { "type": "integer", "minimum": 0 },
          "to_task_index": { "type": "integer", "minimum": 0 },
          "edge_type": { "type": "string", "enum": ["BLOCKS", "INFORMS", "RELATED"] }
        }
      }
    },
    "estimated_phases": { "type": "array", "items": { "type": "string" } },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "overall_risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
              "mitigation": { "type": "string" }
            }
          }
        }
      }
    },
    "clarification_needed": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": "string", "format": "date-time" },
    "gate_id": { "type": "string" },
    "superseded_by": { "type": "string", "pattern": "^PLAN-\\d{8}-\\d{3}$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "additionalProperties": false
}