{
  "name": "loop-engineering",
  "version": "0.1.0",
  "description": "Loop Engineering MCP Server - AI agent governance framework",
  "type": "module",
  "main": "dist/src/server/index.js",
  "bin": {
    "loop": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.1.0"
  }
}
