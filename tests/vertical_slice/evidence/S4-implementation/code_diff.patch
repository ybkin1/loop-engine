+"""API Gateway — Request routing, auth middleware, rate limiting."""
+
+from flask import Flask, request, jsonify
+from src.auth_module import AuthModule
+from src.task_module import TaskModule
+
+app = Flask(__name__)
+auth = AuthModule()
+task = TaskModule()
+
+
+@app.route("/api/auth/login", methods=["POST"])
+def login():
+    data = request.get_json()
+    token = auth.login(data.get("username"), data.get("password"))
+    if token:
+        return jsonify({"token": token, "user": {"username": data["username"]}})
+    return jsonify({"error": "Invalid credentials"}), 401
+
+
+@app.route("/api/auth/register", methods=["POST"])
+def register():
+    data = request.get_json()
+    user_id = auth.register(data["username"], data["password"], data["email"])
+    return jsonify({"id": user_id, "message": "User created"}), 201
+
+
+@app.route("/api/tasks", methods=["GET"])
+def get_tasks():
+    user = auth.verify_token(request.headers.get("Authorization"))
+    if not user:
+        return jsonify({"error": "Unauthorized"}), 401
+    keyword = request.args.get("q")
+    tasks = task.get_tasks(user["id"], keyword)
+    return jsonify(tasks)
+
+
+@app.route("/api/tasks", methods=["POST"])
+def create_task():
+    user = auth.verify_token(request.headers.get("Authorization"))
+    if not user:
+        return jsonify({"error": "Unauthorized"}), 401
+    data = request.get_json()
+    task_id = task.create_task(user["id"], data["title"], data.get("description"), data.get("due_date"))
+    return jsonify({"id": task_id, "title": data["title"]}), 201
