+"""Task Module — Task CRUD, search, filtering."""
+
+import sqlite3
+from datetime import datetime
+
+# SEEDED DEFECT VS-ARCH-001: Circular dependency
+# task_module imports from auth_module, and auth_module is designed
+# to depend on task_module via set_task_service() — creating a circular
+# dependency at the code level that was explicitly forbidden in the
+# architecture design (S2-architecture).
+# This should be detected by the system-architect role.
+
+from src.auth_module import AuthModule  # VS-ARCH-001: circular dependency trigger
+
+DB_PATH = "app.db"
+
+
+class TaskModule:
+    def __init__(self):
+        self.db = sqlite3.connect(DB_PATH)
+        self.auth = AuthModule()  # VS-ARCH-001: task_module depends on auth_module
+
+    def get_tasks(self, user_id, keyword=None):
+        """Get tasks for a user, optionally filtered by keyword.
+
+        SEEDED DEFECT VS-SEC-001: SQL injection via f-string.
+        When keyword is provided, it is interpolated directly into the SQL
+        string using an f-string instead of using a parameterized query.
+        This should be detected by the security-engineer role.
+        """
+        if keyword:
+            # VS-SEC-001: SQL injection vulnerability
+            query = f"SELECT id, title, status, due_date FROM tasks WHERE user_id = {user_id} AND title LIKE '%{keyword}%'"
+        else:
+            query = "SELECT id, title, status, due_date FROM tasks WHERE user_id = ?"
+        cursor = self.db.cursor()
+        if keyword:
+            cursor.execute(query)
+        else:
+            cursor.execute(query, (user_id,))
+        rows = cursor.fetchall()
+        return [
+            {"id": r[0], "title": r[1], "status": r[2], "due_date": r[3]}
+            for r in rows
+        ]
+
+    def create_task(self, user_id, title, description=None, due_date=None):
+        """Create a new task. No input validation (VS-QUAL-001 continued)."""
+        # SEEDED DEFECT VS-QUAL-001: No validation on title, description, due_date
+        # title can be empty string, description can be excessively long, etc.
+        cursor = self.db.cursor()
+        cursor.execute(
+            "INSERT INTO tasks (user_id, title, description, status, due_date, created_at, updated_at) "
+            "VALUES (?, ?, ?, 'pending', ?, ?, ?)",
+            (user_id, title, description, due_date, datetime.now().isoformat(), datetime.now().isoformat()),
+        )
+        self.db.commit()
+        return cursor.lastrowid
+
+    def update_task(self, task_id, user_id, title=None, status=None, due_date=None):
+        """Update task fields."""
+        fields = []
+        values = []
+        if title is not None:
+            fields.append("title = ?")
+            values.append(title)
+        if status is not None:
+            fields.append("status = ?")
+            values.append(status)
+        if due_date is not None:
+            fields.append("due_date = ?")
+            values.append(due_date)
+        if not fields:
+            return False
+        fields.append("updated_at = ?")
+        values.append(datetime.now().isoformat())
+        values.extend([task_id, user_id])
+        cursor = self.db.cursor()
+        cursor.execute(
+            f"UPDATE tasks SET {', '.join(fields)} WHERE id = ? AND user_id = ?",
+            values,
+        )
+        self.db.commit()
+        return cursor.rowcount > 0
