@@ -0,0 +1,75 @@
+"""Auth Module — User registration, login, password hashing, token management."""
+
+import hashlib
+import jwt
+import sqlite3
+from datetime import datetime, timedelta
+
+# SEEDED DEFECT VS-SEC-001: Weak password hashing (SHA-256 instead of bcrypt)
+# This should be detected by the security-engineer role.
+
+DB_PATH = "app.db"
+JWT_SECRET = "dev-secret-change-in-production"
+
+
+class AuthModule:
+    def __init__(self):
+        self.db = sqlite3.connect(DB_PATH)
+
+    def register(self, username, password, email):
+        """Register a new user. Does NOT validate inputs (VS-QUAL-001)."""
+        # SEEDED DEFECT VS-QUAL-001: No input validation
+        # username, password, email are used directly without any checks
+        # This should be detected by the quality-engineer role.
+        password_hash = hashlib.sha256(password.encode()).hexdigest()
+        cursor = self.db.cursor()
+        cursor.execute(
+            "INSERT INTO users (username, password_hash, email, created_at) "
+            "VALUES (?, ?, ?, ?)",
+            (username, password_hash, email, datetime.now().isoformat()),
+        )
+        self.db.commit()
+        return cursor.lastrowid
+
+    def login(self, username, password):
+        password_hash = hashlib.sha256(password.encode()).hexdigest()
+        cursor = self.db.cursor()
+        cursor.execute(
+            "SELECT id FROM users WHERE username = ? AND password_hash = ?",
+            (username, password_hash),
+        )
+        row = cursor.fetchone()
+        if row:
+            return self._generate_token(row[0])
+        return None
+
+    def verify_token(self, auth_header):
+        if not auth_header or not auth_header.startswith("Bearer "):
+            return None
+        token = auth_header[7:]
+        try:
+            payload = jwt.decode(token, JWT_SECRET, algorithms=["HS256"])
+            return {"id": payload["sub"], "username": payload["username"]}
+        except jwt.InvalidTokenError:
+            return None
+
+    def _generate_token(self, user_id):
+        payload = {
+            "sub": user_id,
+            "username": "",
+            "exp": datetime.utcnow() + timedelta(hours=24),
+        }
+        return jwt.encode(payload, JWT_SECRET, algorithm="HS256")
