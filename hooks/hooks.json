{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/loop_auto_activate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/template_injector.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/session_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/loop_enforcement.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/gate_guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/role_isolation.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${ZCODE_PLUGIN_ROOT}/hooks/scripts/path_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}